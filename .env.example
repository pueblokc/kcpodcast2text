# Application Settings
APP_NAME=Podcast Transcription Archive
DEBUG=False
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/podcasts.db

# Transcription API Keys (Optional - leave empty to use local Whisper)
OPENAI_API_KEY=
HUGGINGFACE_API_TOKEN=
DEEPGRAM_API_KEY=

# Transcription Settings
DEFAULT_TRANSCRIPTION_PROVIDER=local  # local, openai, huggingface, deepgram
WHISPER_MODEL_SIZE=base  # tiny, base, small, medium, large
MAX_FILES_PER_DAY=50
BATCH_SIZE=5

# Storage Paths
MODELS_DIR=./models
DATA_DIR=./data
TEMP_DIR=./data/temp
TRANSCRIPTS_DIR=./data/transcripts

# Redis (for background tasks)
REDIS_URL=redis://localhost:6379/0

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# External Integrations (Optional)
GOOGLE_DRIVE_CREDENTIALS=
NOTION_API_KEY=
NOTION_DATABASE_ID=
